<Window x:Class="KatalogProduktow4K.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katalog produktów" Height="550" Width="1000">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Nazwa produktu"/>
        <TextBox x:Name="NazwaTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10"/>

        <Label Grid.Row="1" Content="Cena"/>
        <TextBox x:Name="CenaTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10"/>

        <Label Grid.Row="2" Content="Ilość"/>
        <TextBox x:Name="IloscTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,10"/>

        <Label Grid.Row="3" Content="Kategoria"/>
        <ComboBox x:Name="KategorieComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10"/>

        <Label Grid.Row="4" Content="Promocja"/>
        <CheckBox x:Name="PromocjaCheckBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,10"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Oblicz wartość" Click="Oblicz" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Dodaj produkt" Click="DodajProdukt" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Usuń produkt" Click="UsunProdukt" Padding="10,5"/>
            <Button Content="Zapisz zmiany" Click="EdytujProdukt" Padding="10,5" Margin="10,0,0,0"/>

        </StackPanel>

        <Label x:Name="WynikTextBlock" Grid.Row="6" Grid.ColumnSpan="2"
               FontSize="16" Margin="0,10"/>

        <!-- Lista produktów -->
        <ListView x:Name="ListaProduktow"
                  Grid.Row="7" Grid.ColumnSpan="2"
                  Margin="0,0,15,0"
                  ItemsSource="{Binding produkty}"
                  SelectionChanged="PokazZaznaczony">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Nazwa}" Width="130"/>
                    <GridViewColumn Header="Cena" DisplayMemberBinding="{Binding Cena}" Width="80"/>
                    <GridViewColumn Header="Ilość" DisplayMemberBinding="{Binding Ilosc}" Width="70"/>
                    <GridViewColumn Header="Kategoria" DisplayMemberBinding="{Binding Kategoria}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
        
        <!-- Informacje po prawej -->
        <StackPanel Grid.Column="2" Grid.RowSpan="8" Margin="10,0,0,0">
            <Label Content="Informacje o produkcie" FontSize="18" FontWeight="Bold"/>

            <ListView x:Name="InformacjeProduktow" Height="150">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Pole" DisplayMemberBinding="{Binding Pole}" Width="100"/>
                        <GridViewColumn Header="Wartość" DisplayMemberBinding="{Binding Wartosc}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="WartoscMagazynuText" FontSize="16" FontWeight="Bold" Margin="0,15,0,0" Text="Wartość magazynu: 0 zł"/>

        </StackPanel>

    </Grid>
</Window>
